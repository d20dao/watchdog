{
  "name": "d20dao-watchdog",
  "version": "0.1.0",
  "private": true,
  "description": "External watchdog for the D20DAO VRF keepers on Cloudflare Workers",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "dev": "wrangler dev --test-scheduled",
    "check": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "~4.132.0"
  },
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0"
  }
}
